@{
    var c = 0;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Hoverable Table rows -->
<div class="container">
    <div class="card">
        <h5 class="card-header">Supplier Data</h5>
        <div class="table-responsive text-nowrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Business Name</th>
                        <th>Store Name</th>
                        <th>GSTIN</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>State</th>
                        <th>Country</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var supplier in Model)
                    {
                        c = c + 1;
                        <tr>
                            <td>@c</td>
                            <td>@supplier.BusinessName</td>
                            <td>@supplier.StoreName</td>
                            <td>@supplier.GSTIN</td>
                            <td>@supplier.Email</td>
                            <td>@supplier.PhoneNumber</td>
                            <td>@supplier.State</td>
                            <td>@supplier.Country</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="ri-more-2-line"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-controller="Supplier" asp-action="Edit" asp-route-Id="@supplier.Id"><i class="ri-pencil-line me-1"></i> Edit</a>
                                        <a class="dropdown-item" asp-controller="Supplier" asp-action="Delete" asp-route-Id="@supplier.Id"><i class="ri-delete-bin-6-line me-1"></i> Delete</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
